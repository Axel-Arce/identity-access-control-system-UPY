# Shared Postgres database (Supabase). Ask Axel for the connection string.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Twilio (ask Axel for these values)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Fernet key used to encrypt/decrypt stored phone numbers (ask Axel; must be the same for everyone)
FERNET_PHONE_KEY=
